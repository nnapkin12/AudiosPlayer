{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audios!",
  "version": "0.4.0",
  "identifier": "com.audios.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Audios!",
        "width": 1240,
        "height": 820,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Music",
    "shortDescription": "Play local music",
    "linux": {
      "deb": {
        "desktopTemplate": "./template.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
